<%- include('../partials/site-head', { title: 'Contato · GLTechCWB', navActive: 'contact' }) %>
<% if (typeof contactJsonLd !== 'undefined' && contactJsonLd) { %>
  <script type="application/ld+json"><%- contactJsonLd %></script>
<% } %>

<% if (typeof contactJsonLd !== 'undefined' && contactJsonLd) { %>
  <script type="application/ld+json"><%- contactJsonLd %></script>
<% } %>

<main class="contact-page">
  <div class="container">
    <section class="page-hero">
      <span class="eyebrow">Atendimento</span>
      <h1>Contato</h1>
      <p>Fale com a gente: WhatsApp, telefone, e-mail ou presencial. Atendimento de segunda a sexta, das 08:00 às 18:00.</p>
    </section>

    <section class="contact-grid">
      <div class="contact-info">
        <div class="contact-card">
          <h2>Informações da loja</h2>
          <ul class="contact-list">
            <% if (storeLocal && storeLocal.street) { %>
              <li class="contact-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
                <div>
                  <strong>Endereço</strong>
                  <address>
                    <%= storeLocal.street %><br>
                    <%= storeLocal.neighborhood %><br>
                    <%= storeLocal.city %>/<%= storeLocal.state %> · CEP <%= storeLocal.postalCode %>
                  </address>
                </div>
              </li>
            <% } %>
            <% if (contactPhone) { %>
              <li class="contact-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <div>
                  <strong>Telefone</strong>
                  <a href="tel:<%= contactPhone.replace(/\D/g, '') %>"><%= contactPhone %></a>
                </div>
              </li>
            <% } %>
            <% if (contactWhatsapp) { %>
              <li class="contact-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                <div>
                  <strong>WhatsApp</strong>
                  <a href="<%= whatsappUrl(contactWhatsapp, 'Olá! Gostaria de falar com a GLTechCWB.') %>" target="_blank" rel="noopener">Chamar no WhatsApp</a>
                </div>
              </li>
            <% } %>
            <% if (contactEmail) { %>
              <li class="contact-item">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
                <div>
                  <strong>E-mail</strong>
                  <a href="mailto:<%= contactEmail %>"><%= contactEmail %></a>
                </div>
              </li>
            <% } %>
          </ul>
        </div>

        <div class="contact-card">
          <h2>Horário de atendimento</h2>
          <p class="contact-hours">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <%= storeLocal && storeLocal.openingHoursNote || 'Segunda a sexta, das 08:00 às 18:00.' %>
          </p>
        </div>
      </div>

      <div class="contact-map">
        <div class="contact-card">
          <h2>Onde estamos</h2>
          <iframe
            src="<%= mapsEmbed %>"
            width="100%" height="360" style="border:0" allowfullscreen loading="lazy"
            referrerpolicy="no-referrer-when-downgrade" title="Mapa — GLTechCWB em <%= storeLocal && storeLocal.neighborhood || 'Curitiba' %>"></iframe>
        </div>
      </div>
    </section>
  </div>
</main>

<%- include('../partials/site-foot') %>
