<%- include('../partials/site-head', { title: 'Finalizar compra', navActive: 'checkout' }) %>

<div class="container checkout-page">
  <h1>Finalizar compra</h1>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert--error"><%= error %></div>
  <% } %>

  <div class="checkout-grid">
    <!-- Forma de recebimento -->
    <% if (pickupEnabled) { %>
    <div class="checkout-section">
      <h2>Como você quer receber?</h2>
      <div class="payment-methods">
        <label class="payment-method">
          <input type="radio" name="fulfillment" value="delivery" checked />
          <div class="payment-method__info">
            <strong>Receber em casa</strong>
            <span>Entrega no endereço informado</span>
          </div>
        </label>
        <label class="payment-method">
          <input type="radio" name="fulfillment" value="pickup" />
          <div class="payment-method__info">
            <strong>Retirar na loja</strong>
            <span>Sem custo de frete</span>
          </div>
        </label>
      </div>
      <div id="pickup-panel" class="pickup-panel" style="display:none;">
        <div class="shipping-info">
          <p><strong>Retirada na loja</strong></p>
          <p>Endereço: <%= pickupAddress %></p>
          <% if (pickupHours) { %>
            <p>Horário de retirada: <%= pickupHours %></p>
          <% } %>
        </div>
      </div>
    </div>
    <% } %>

    <div id="delivery-sections">
    <!-- Etapa 1: Endereço -->
    <div class="checkout-section">
      <h2>1. Endereço de entrega</h2>

      <% if (customer.addresses && customer.addresses.length) { %>
        <form method="POST" action="/checkout/frete" class="checkout-form">
          <div class="address-select">
            <% customer.addresses.forEach(function(addr) { %>
              <label class="address-option <%= addr.isDefault ? 'address-option--selected' : '' %>">
                <input type="radio" name="addressId" value="<%= addr._id %>"
                  <%= addr.isDefault ? 'checked' : '' %> />
                <div>
                  <strong><%= addr.label || 'Endereço' %></strong>
                  <p><%= addr.street %>, <%= addr.number %><%= addr.complement ? ' — ' + addr.complement : '' %></p>
                  <p><%= addr.district ? addr.district + ' — ' : '' %><%= addr.city %> — <%= addr.state %></p>
                  <p>CEP: <%= addr.zipCode %></p>
                </div>
              </label>
            <% }) %>
          </div>
          <a href="/conta" class="btn btn--ghost btn--sm">Gerenciar endereços</a>
        </form>
      <% } %>

      <div class="checkout-cep-form" style="margin-top:16px;">
        <p class="text-muted">Ou informe o CEP para calcular o frete:</p>
        <form method="POST" action="/checkout/frete" class="form-row" style="align-items:flex-end; gap:8px;">
          <input type="text" name="zipCode" placeholder="00000-000" maxlength="9" required
                 value="<%= shipping ? shipping.zipCode : '' %>" style="flex:1; padding:10px 12px; background:var(--bg); border:1px solid var(--border); border-radius:var(--radius-sm); color:var(--text);" />
          <button type="submit" class="btn btn--primary">Calcular</button>
        </form>
      </div>
    </div>

    <!-- Etapa 2: Frete -->
    <% if (shipping) { %>
    <div class="checkout-section">
      <h2>2. Frete</h2>
      <div class="shipping-info">
        <p><strong><%= shipping.city %> — <%= shipping.state %></strong></p>
        <p>
          <% if (shipping.freeShipping) { %>
            <span class="text-accent">Frete grátis!</span>
          <% } else { %>
            Frete: <strong><%= formatPrice(shipping.cost) %></strong>
          <% } %>
          — Entrega em até <strong><%= shipping.deliveryDays %> dias úteis</strong>
        </p>
      </div>
    </div>
    <% } %>
    </div>

    <!-- Etapa 3: Pagamento -->
    <div class="checkout-section">
      <h2>3. Pagamento</h2>
      <form method="POST" action="/checkout/pay" class="checkout-form" id="payment-form">
        <input type="hidden" name="fulfillment" id="fulfillment-input" value="delivery" />
        <input type="hidden" name="addressId" value="" />

        <div class="payment-methods">
          <label class="payment-method">
            <input type="radio" name="paymentMethod" value="pix" checked />
            <div class="payment-method__info">
              <strong>Pix</strong>
              <span>Aprovação instantânea</span>
            </div>
          </label>
          <label class="payment-method">
            <input type="radio" name="paymentMethod" value="credit_card" />
            <div class="payment-method__info">
              <strong>Cartão de crédito</strong>
              <span>Até 12x</span>
            </div>
          </label>
        </div>
      </form>

      <div id="pix-box" style="display:none;"></div>
    </div>
  </div>

  <!-- Resumo do pedido -->
  <div class="checkout-summary">
    <h2>Resumo do pedido</h2>
    <div class="checkout-items">
      <% cart.items.forEach(function(item) { %>
        <div class="checkout-item">
          <span><%= item.name %> x<%= item.quantity %></span>
          <span><%= formatPrice(item.unitPrice * item.quantity) %></span>
        </div>
      <% }) %>
    </div>
    <div class="checkout-totals">
      <div class="checkout-total-row">
        <span>Subtotal</span>
        <span><%= formatPrice(cart.items.reduce(function(sum, item) { return sum + item.unitPrice * item.quantity; }, 0)) %></span>
      </div>
      <div class="checkout-total-row" id="frete-delivery-row">
        <span>Frete</span>
        <span>
          <% if (shipping) { %>
            <%= shipping.freeShipping ? 'Grátis' : formatPrice(shipping.cost) %>
          <% } else { %>
            Informe o CEP
          <% } %>
        </span>
      </div>
      <div class="checkout-total-row" id="frete-pickup-row" style="display:none;">
        <span>Frete</span>
        <span>Grátis (retirada)</span>
      </div>
      <div class="checkout-total-row checkout-total-row--total">
        <span>Total</span>
        <span id="total-delivery">
          <%= formatPrice(
            cart.items.reduce(function(sum, item) { return sum + item.unitPrice * item.quantity; }, 0) +
            (shipping ? shipping.cost : 0)
          ) %>
        </span>
        <span id="total-pickup" style="display:none;">
          <%= formatPrice(cart.items.reduce(function(sum, item) { return sum + item.unitPrice * item.quantity; }, 0)) %>
        </span>
      </div>
    </div>

    <% if (shipping || pickupEnabled) { %>
      <div id="payment-btn-wrap">
        <button id="btn-pagar" type="submit" form="payment-form" class="btn btn--primary btn--full" style="margin-top:20px;">
          Pagar com Mercado Pago
        </button>
      </div>
      <p id="frete-need-cep" class="text-muted" style="text-align:center; margin-top:16px;">Informe o CEP para continuar</p>
    <% } else { %>
      <p class="text-muted" style="text-align:center; margin-top:16px;">Informe o CEP para continuar</p>
    <% } %>
  </div>
</div>

<%- include('../partials/site-foot') %>

<script>
(function () {
  var form = document.getElementById('payment-form');
  var btn = document.getElementById('btn-pagar');
  var btnWrap = document.getElementById('payment-btn-wrap');
  var pixBox = document.getElementById('pix-box');
  if (!form || !btn || !pixBox) return;

  var radios = form.querySelectorAll('input[name="paymentMethod"]');
  var pollTimer = null;

  var fulfillmentInput = document.getElementById('fulfillment-input');
  var fulfillmentRadios = document.querySelectorAll('input[name="fulfillment"]');
  var deliverySections = document.getElementById('delivery-sections');
  var pickupPanel = document.getElementById('pickup-panel');
  var freteDeliveryRow = document.getElementById('frete-delivery-row');
  var fretePickupRow = document.getElementById('frete-pickup-row');
  var totalDelivery = document.getElementById('total-delivery');
  var totalPickup = document.getElementById('total-pickup');
  var needCep = document.getElementById('frete-need-cep');
  var hasShipping = <%= shipping ? true : false %>;

  function applyFulfillment() {
    var sel = form.querySelector('input[name="fulfillment"]:checked');
    var p = sel ? sel.value : 'delivery';
    var isPickup = p === 'pickup';
    if (fulfillmentInput) fulfillmentInput.value = p;

    if (deliverySections) deliverySections.style.display = isPickup ? 'none' : '';
    if (pickupPanel) pickupPanel.style.display = isPickup ? 'block' : 'none';
    if (freteDeliveryRow) freteDeliveryRow.style.display = isPickup ? 'none' : '';
    if (fretePickupRow) fretePickupRow.style.display = isPickup ? '' : 'none';
    if (totalDelivery) totalDelivery.style.display = isPickup ? 'none' : '';
    if (totalPickup) totalPickup.style.display = isPickup ? '' : 'none';

    var blocked = !isPickup && !hasShipping;
    btn.disabled = blocked;
    if (needCep) needCep.style.display = blocked ? 'block' : 'none';
  }
  fulfillmentRadios.forEach(function (r) { r.addEventListener('change', applyFulfillment); });
  applyFulfillment();

  function currentMethod() {
    var sel = form.querySelector('input[name="paymentMethod"]:checked');
    return sel ? sel.value : '';
  }

  function updateLabel() {
    btn.textContent = currentMethod() === 'pix' ? 'Pagar com Pix' : 'Pagar com Cartão de Crédito';
  }
  radios.forEach(function (r) { r.addEventListener('change', updateLabel); });
  updateLabel();

  btn.addEventListener('click', function (e) {
    if (currentMethod() !== 'pix') return;
    e.preventDefault();
    startPix();
  });

  function startPix() {
    btn.disabled = true;
    btn.textContent = 'Gerando Pix...';
    fetch('/checkout/pix', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function (r) {
        if (r.redirected) { window.location.href = r.url; return null; }
        return r.json();
      })
      .then(function (data) {
        if (!data) return;
        if (!data.success) throw new Error(data.message || 'Não foi possível gerar o Pix.');
        showPix(data);
      })
      .catch(function (err) {
        btn.disabled = false;
        updateLabel();
        alert(err.message || 'Não foi possível gerar o Pix. Tente novamente.');
      });
  }

  function showPix(data) {
    form.style.display = 'none';
    if (btnWrap) btnWrap.style.display = 'none';

    var html = '<div class="pix-panel">';
    html += '<p style="font-weight:600; margin-bottom:14px;">Escaneie o QR Code ou copie o código para pagar</p>';
    if (data.qrBase64) {
      html += '<img src="data:image/png;base64,' + data.qrBase64 + '" alt="QR Code Pix" />';
    }
    if (data.qrText) {
      html += '<textarea id="pix-copy-key" readonly rows="4">' + data.qrText + '</textarea>';
      html += '<button type="button" id="btn-copy-pix" class="btn btn--primary btn--full" style="margin-top:12px;">Copiar código Pix</button>';
    }
    html += '<p class="hint">A confirmação é automática após o pagamento.</p>';
    html += '<p class="date">Pode fechar esta página e <a href="/conta/pedidos">acompanhar o pedido</a>.</p>';
    html += '<p id="pix-confirm-msg" class="pix-confirmed" style="display:none;">Pagamento confirmado!</p>';
    html += '</div>';
    pixBox.innerHTML = html;
    pixBox.style.display = 'block';

    var copyBtn = document.getElementById('btn-copy-pix');
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var ta = document.getElementById('pix-copy-key');
        ta.focus();
        ta.select();
        ta.setSelectionRange(0, 99999);
        try { document.execCommand('copy'); } catch (e) {}
        if (navigator.clipboard) {
          navigator.clipboard.writeText(data.qrText).catch(function () {});
        }
        copyBtn.textContent = 'Copiado!';
        setTimeout(function () { copyBtn.textContent = 'Copiar código Pix'; }, 2000);
      });
    }

    var tried = 0;
    pollTimer = setInterval(function () {
      tried++;
      fetch('/checkout/pix-status?paymentId=' + encodeURIComponent(data.paymentId), { credentials: 'same-origin' })
        .then(function (r) { return r.json(); })
        .then(function (s) {
          if (s.paid) {
            clearInterval(pollTimer);
            var msg = document.getElementById('pix-confirm-msg');
            if (msg) msg.style.display = 'flex';
            window.setTimeout(function () { window.location.href = '/checkout/sucesso?payment_id=' + encodeURIComponent(data.paymentId); }, 2500);
          }
        })
        .catch(function () {});
      if (tried >= 120) clearInterval(pollTimer);
    }, 5000);
  }
})();
</script>
