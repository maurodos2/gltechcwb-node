<%- include('../../partials/admin-head', { title: 'Pedido #' + String(order._id).slice(-8).toUpperCase() }) %>

<div class="page-header">
  <h1>Pedido #<%= String(order._id).slice(-8).toUpperCase() %></h1>
  <a class="btn" href="/admin/orders">← Voltar</a>
</div>

<div class="order-detail-grid">
  <div class="order-detail-section">
    <h2>Cliente</h2>
    <p><strong><%= order.customer.name %></strong></p>
    <p><%= order.customer.email %></p>
    <% if (order.customer.phone) { %><p><%= order.customer.phone %></p><% } %>
  </div>

  <div class="order-detail-section">
    <h2>Endereço de entrega</h2>
    <% if (order.shippingAddress && order.shippingAddress.street) { %>
      <p><%= order.shippingAddress.street %>, <%= order.shippingAddress.number %><%= order.shippingAddress.complement ? ' — ' + order.shippingAddress.complement : '' %></p>
      <p><%= order.shippingAddress.district ? order.shippingAddress.district + ' — ' : '' %><%= order.shippingAddress.city %> — <%= order.shippingAddress.state %></p>
      <p>CEP: <%= order.shippingAddress.zipCode %></p>
    <% } else { %>
      <p class="text-muted">Não informado</p>
    <% } %>
  </div>

  <div class="order-detail-section">
    <h2>Status</h2>
    <form method="POST" action="/admin/orders/<%= order._id %>/status" class="form-row" style="align-items:flex-end; gap:8px;">
      <select name="status" style="flex:1; padding:8px; background:var(--bg); border:1px solid var(--border); border-radius:var(--radius-sm); color:var(--text);">
        <option value="pending_payment" <%= order.status === 'pending_payment' ? 'selected' : '' %>>Aguardando pagamento</option>
        <option value="paid" <%= order.status === 'paid' ? 'selected' : '' %>>Pago</option>
        <option value="processing" <%= order.status === 'processing' ? 'selected' : '' %>>Preparando envio</option>
        <option value="shipped" <%= order.status === 'shipped' ? 'selected' : '' %>>Enviado</option>
        <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Entregue</option>
        <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelado</option>
      </select>
      <button type="submit" class="btn btn--primary">Atualizar</button>
    </form>
    <% if (order.paymentProviderRef) { %>
      <p style="margin-top:8px; font-size:0.85rem; color:var(--text-muted);">Ref. pagamento: <%= order.paymentProviderRef %></p>
    <% } %>
  </div>
</div>

<div class="order-detail-section" style="margin-top:24px;">
  <h2>Itens</h2>
  <table class="data-table">
    <thead>
      <tr>
        <th>Produto</th>
        <th>Preço un.</th>
        <th>Qtd</th>
        <th>Subtotal</th>
      </tr>
    </thead>
    <tbody>
      <% order.items.forEach(function(item) { %>
        <tr>
          <td><%= item.name %></td>
          <td><%= formatPrice(item.unitPrice) %></td>
          <td><%= item.quantity %></td>
          <td><%= formatPrice(item.unitPrice * item.quantity) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div style="margin-top:16px; text-align:right;">
    <p>Subtotal: <strong><%= formatPrice(order.itemsTotal) %></strong></p>
    <p>Frete: <strong><%= order.shippingCost > 0 ? formatPrice(order.shippingCost) : 'Grátis' %></strong></p>
    <p style="font-size:1.2rem; color:var(--accent);">Total: <strong><%= formatPrice(order.total) %></strong></p>
  </div>
</div>

<% if (order.notes) { %>
  <div class="order-detail-section" style="margin-top:24px;">
    <h2>Observações</h2>
    <p><%= order.notes %></p>
  </div>
<% } %>

<p style="margin-top:24px; font-size:0.85rem; color:var(--text-muted);">
  Criado em: <%= new Date(order.createdAt).toLocaleString('pt-BR') %>
  <% if (order.updatedAt) { %> · Atualizado: <%= new Date(order.updatedAt).toLocaleString('pt-BR') %><% } %>
</p>

<%- include('../../partials/admin-foot') %>
