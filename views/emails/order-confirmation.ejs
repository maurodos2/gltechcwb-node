<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Pedido confirmado</title>
</head>
<body style="margin:0; padding:0; background:#060a08; font-family:Arial, Helvetica, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#060a08; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background:#0f1a14; border-radius:12px; overflow:hidden;">
          <!-- Header -->
          <tr>
            <td style="padding:32px 40px; background:#0b2e1c; text-align:center;">
              <h1 style="margin:0; color:#3ddc84; font-size:24px;">GLTechCWB</h1>
              <p style="margin:8px 0 0; color:#a0b8a8; font-size:14px;">Pedido confirmado!</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:32px 40px;">
              <p style="color:#e0e0e0; font-size:16px; margin:0 0 16px;">
                Olá, <strong><%= order.customer.name %></strong>!
              </p>
              <p style="color:#a0b8a8; font-size:14px; line-height:1.6; margin:0 0 24px;">
                Seu pedido <strong>#<%= String(order._id).slice(-8).toUpperCase() %></strong> foi recebido e está sendo processado.
              </p>

              <!-- Itens -->
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                <tr>
                  <td style="padding:12px 0; border-bottom:1px solid #1a2e22; color:#a0b8a8; font-size:12px; text-transform:uppercase; letter-spacing:0.05em;">
                    Produto
                  </td>
                  <td style="padding:12px 0; border-bottom:1px solid #1a2e22; color:#a0b8a8; font-size:12px; text-transform:uppercase; text-align:right;">
                    Qtd
                  </td>
                  <td style="padding:12px 0; border-bottom:1px solid #1a2e22; color:#a0b8a8; font-size:12px; text-transform:uppercase; text-align:right;">
                    Subtotal
                  </td>
                </tr>
                <% order.items.forEach(function(item) { %>
                <tr>
                  <td style="padding:12px 0; border-bottom:1px solid #1a2e22; color:#e0e0e0; font-size:14px;">
                    <%= item.name %>
                  </td>
                  <td style="padding:12px 0; border-bottom:1px solid #1a2e22; color:#e0e0e0; font-size:14px; text-align:right;">
                    <%= item.quantity %>
                  </td>
                  <td style="padding:12px 0; border-bottom:1px solid #1a2e22; color:#e0e0e0; font-size:14px; text-align:right;">
                    <%= formatPrice(item.unitPrice * item.quantity) %>
                  </td>
                </tr>
                <% }) %>
              </table>

              <!-- Totais -->
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="padding:6px 0; color:#a0b8a8; font-size:13px;">Subtotal</td>
                  <td style="padding:6px 0; color:#e0e0e0; font-size:13px; text-align:right;"><%= formatPrice(order.itemsTotal) %></td>
                </tr>
                <tr>
                  <td style="padding:6px 0; color:#a0b8a8; font-size:13px;">Frete</td>
                  <td style="padding:6px 0; color:#e0e0e0; font-size:13px; text-align:right;">
                    <%= order.shippingCost > 0 ? formatPrice(order.shippingCost) : 'Grátis' %>
                  </td>
                </tr>
                <tr>
                  <td style="padding:12px 0; color:#3ddc84; font-size:18px; font-weight:bold; border-top:1px solid #1a2e22;">Total</td>
                  <td style="padding:12px 0; color:#3ddc84; font-size:18px; font-weight:bold; text-align:right; border-top:1px solid #1a2e22;"><%= formatPrice(order.total) %></td>
                </tr>
              </table>

              <!-- Endereço -->
              <% if (order.shippingAddress && order.shippingAddress.street) { %>
              <div style="margin-top:24px; padding:16px; background:#0b1a10; border-radius:8px;">
                <p style="color:#a0b8a8; font-size:12px; text-transform:uppercase; margin:0 0 8px;">Endereço de entrega</p>
                <p style="color:#e0e0e0; font-size:14px; margin:0; line-height:1.5;">
                  <%= order.shippingAddress.street %><%= order.shippingAddress.number ? ', ' + order.shippingAddress.number : '' %><%= order.shippingAddress.complement ? ' — ' + order.shippingAddress.complement : '' %><br/>
                  <%= order.shippingAddress.district ? order.shippingAddress.district + ' — ' : '' %><%= order.shippingAddress.city %> — <%= order.shippingAddress.state %><br/>
                  CEP: <%= order.shippingAddress.zipCode %>
                </p>
              </div>
              <% } %>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:24px 40px; background:#0b2e1c; text-align:center;">
              <p style="color:#a0b8a8; font-size:12px; margin:0;">
                GLTechCWB — Hardware, periféricos e acessórios<br/>
                Curitiba — PR · contato@gltechcwb.com
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
