# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA suba o .env real para o Git.

# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados
# Local: mongodb://127.0.0.1:27017/gltechcwb
# Atlas (nuvem): mongodb+srv://usuario:senha@cluster.mongodb.net/gltechcwb
MONGO_URI=mongodb://127.0.0.1:27017/gltechcwb

# Sessão / autenticação do admin
SESSION_SECRET=troque_por_uma_string_aleatoria_longa

# Credenciais do primeiro admin (usadas apenas pelo script de seed)
SEED_ADMIN_EMAIL=admin@gltechcwb.com
SEED_ADMIN_PASSWORD=troque_esta_senha

# Domínio público (usado em links absolutos, sitemap, etc.)
SITE_URL=https://gltechcwb.com

# Contato do site público (opcionais: WhatsApp e e-mail exibidos na vitrine)
CONTACT_WHATSAPP=5541999999999
CONTACT_EMAIL=contato@gltechcwb.com

# ---- E-commerce ----

# Mercado Pago (checkout transparente)
# Gerar credenciais em: https://www.mercadopago.com.br/developers/pt/docs
MP_ACCESS_TOKEN=APP_USR-xxxx
MP_PUBLIC_KEY=APP_USR-xxxx

# E-mail transacional
# EM PRODUÇÃO (Render): use a API do Resend — o SMTP do Zoho não é alcançável a partir
# do Render (timeout em 587/465/25). Com RESEND_API_KEY setada, o envio vai pela API.
# Crie a chave em https://resend.com/api-keys e verifique o domínio do remetente
# (Settings > Domains, registro DNS TXT tipo MX/RECORD) — use o mesmo domínio de EMAIL_FROM.
RESEND_API_KEY=re_xxxxxxxx
# Local/dev: SMTP do Zoho (funciona da sua rede). Ignorado se RESEND_API_KEY estiver setada.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seuemail@gltechcwb.com
SMTP_PASS=sua_senha_zoho
EMAIL_FROM="GLTechCWB <seuemail@gltechcwb.com>"

# Webhook secret (gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
WEBHOOK_SECRET=troque_por_um_hash_aleatorio

# ---- Imagens (Cloudflare R2, compatível com API S3) ----
# Account ID fica no painel R2 (visível na lista de buckets).
R2_ACCOUNT_ID=troque_pelo_account_id
# Token de API S3 criado em R2 > Manage API Tokens (permissão read/write).
R2_ACCESS_KEY_ID=troque
R2_SECRET_ACCESS_KEY=troque
R2_BUCKET=gltechcwb
# Domínio público vinculado ao bucket (ou URL r2.dev padrão).
R2_PUBLIC_BASE_URL=https://images.gltechcwb.com

# ---- Bot do WhatsApp (atendimento automático) ----
# Ativar o bot no boot (true/false). Quando desligado, pode ser iniciado manualmente
# pelo painel /admin/whatsapp.
WHATSAPP_BOT_ENABLED=false
# ID da sessão do whatsapp-web.js (permite rodar mais de uma instância; afeta .wwebjs_auth/)
WHATSAPP_BOT_SESSION=gltech
# Opcional: chatId de um GRUPO no WhatsApp para receber alertas de handoff
# (ex.: "120363..."@g.us). Obtenha o ID enviando uma mensagem no grupo via bot
# ou ferramentas de ID de grupo do WhatsApp. Deixe vazio para só notificar no console.
WHATSAPP_HANDOFF_GROUP=
# Segurança anti-backlog: idade máxima (segundos) das mensagens que o bot responde.
# Ao reconectar, o WhatsApp reprocessa mensagens do período offline — sem este filtro
# o bot responderia em rajada. Default 120.
WHATSAPP_MAX_MSG_AGE_SEC=120
# Intervalo mínimo (ms) entre respostas automáticas da mesma conversa. Default 3000.
WHATSAPP_COOLDOWN_MS=3000
